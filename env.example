PORT=4000
DB_PATH=./data/orangepi-edge.db
DATA_DIR=./data
IMAGE_UPLOAD_DIR=./data/uploads
SNAPSHOT_IMAGE_BASE_PATH=/uploads
INFERENCE_INTERVAL_MS=25000
AUTO_WATER_COOLDOWN_MS=120000
CORS_ORIGIN=*
DEVICE_UPLOAD_KEY=change-me
MAX_UPLOAD_BYTES=2097152
MODEL_PROVIDER=onnx
MODEL_COMMAND=
MODEL_COMMAND_TIMEOUT_MS=12000
ONNX_MODEL_PATH=./models/mobilenetv4-model.onnx
ONNX_INPUT_WIDTH=224
ONNX_INPUT_HEIGHT=224
ONNX_INPUT_MEAN=127.5
ONNX_INPUT_STD=127.5
ONNX_INDEX_NO_RAIN=0
ONNX_INDEX_RAIN=1
ONNX_EXECUTION_PROVIDERS=cpu
ONNX_FALLBACK_TO_MOCK=true
